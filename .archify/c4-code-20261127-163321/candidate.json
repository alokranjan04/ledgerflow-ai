 "cards": [
  {
   "dot": "cyan",
   "title": "Invariants enforced in code",
   "items": [
    "ToolRegistry.run strips any customer_id argument; ToolContext.customer_id comes from the verified Session",
    "ActionService.confirm executes only if Session.user_turn_seq advanced after propose()",
    "GeminiREST skips a model whose Breaker is open and falls back to the next model"
   ]
  },
  {
   "dot": "violet",
   "title": "Extension points",
   "items": [
    "New tool: an async function + @REGISTRY.tool(...) and a line in a workflow YAML",
    "New channel: implement Transport (frames, play, clear, event)",
    "Scale-out: replace SessionStore / AuditLog with Redis / Cloud SQL implementations"
   ]
  }
 ]

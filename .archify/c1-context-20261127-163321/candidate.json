 "cards": [
  {
   "dot": "cyan",
   "title": "What it does",
   "items": [
    "Answers account-specific loan and card questions by text or live voice, in English, Hindi or Hinglish",
    "Raises disputes, statements and prepayment requests after explicit confirmation and a one-time code",
    "Every number comes from deterministic tools, never from the model; simple questions skip the model entirely"
   ]
  },
  {
   "dot": "rose",
   "title": "Trust boundaries",
   "items": [
    "Customers verify with mobile + date of birth before any data; a one-time code before any change",
    "The model never chooses whose data is read: identity comes from the session",
    "Admin and KPI endpoints need a token; CI deploys keylessly via Workload Identity Federation"
   ]
  },
  {
   "dot": "amber",
   "title": "PoC scope",
   "items": [
    "Enterprise systems are simulated behind the same connector contract real systems would use",
    "Gemini is the only model provider; when it is down, simple questions are still answered from the systems"
   ]
  }
 ]
}
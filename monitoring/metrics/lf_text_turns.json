{
  "name": "lf_text_turns",
  "description": "Text turns by outcome and grounding result",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"ledgerflow-ai\" AND jsonPayload.message=\"text turn\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "labels": [
      {
        "key": "outcome",
        "valueType": "STRING"
      },
      {
        "key": "grounding",
        "valueType": "STRING"
      }
    ]
  },
  "labelExtractors": {
    "outcome": "EXTRACT(jsonPayload.outcome)",
    "grounding": "EXTRACT(jsonPayload.grounding)"
  }
}
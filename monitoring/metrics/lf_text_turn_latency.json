{
  "name": "lf_text_turn_latency",
  "description": "End-to-end text turn latency (ms)",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"ledgerflow-ai\" AND jsonPayload.message=\"text turn\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  },
  "valueExtractor": "EXTRACT(jsonPayload.ms)",
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 40,
      "growthFactor": 1.25,
      "scale": 50
    }
  }
}
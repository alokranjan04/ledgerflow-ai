# Copy to .env — the ONLY env file the app reads. Never commit .env.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.

# Google AI Studio key (text agent + Gemini Live voice). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Text model for chat (function calling)
GEMINI_TEXT_MODEL=gemini-flash-latest
# Native-audio Live model for voice (browser + phone)
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
# Used when the primary text model fails or its circuit breaker is open
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# End-to-end budget for one text turn (seconds)
LLM_TURN_BUDGET_S=30

# Abuse limits per session
CHAT_TURNS_PER_MIN=20
VOICE_STARTS_PER_MIN=4

# Logging: JSON lines for Cloud Logging (set 0 for readable local logs)
LOG_JSON=1
LOG_LEVEL=INFO

# Optional: fix "today" for a reproducible demo (YYYY-MM-DD). Empty = real today.
LEDGERFLOW_AS_OF=

# Protects the fault-injection panel and metrics reset (open the UI with ?admin=<token>).
# Required when deployed: scripts/deploy.sh generates one and stores it in Secret Manager.
ADMIN_TOKEN=

# ---- Phone channel (optional) ----
# vobiz | twilio
TELEPHONY_PROVIDER=vobiz
# https://<service>.run.app or your ngrok URL, no trailing slash (set automatically by scripts/deploy.sh)
PUBLIC_URL=
# Optional random string; media WebSockets without it are rejected
STREAM_TOKEN=
# Stereo call recordings (caller left, agent right)
RECORD_CALLS=0
GCS_RECORDINGS_BUCKET=
